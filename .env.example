# CF-Server-Monitor Workers 源站地址（https 或 wss 均可，只填 origin 部分）
# 支持两种填写方式：
#   1) Workers 默认域名：https://<worker-name>.<account-subdomain>.workers.dev
#   2) Worker 已绑定的自定义域名：https://api.example.com
UPSTREAM_ORIGIN=https://your-worker.your-subdomain.workers.dev

# 可选：主题静态资源（/assets/*）的 Pages 边缘缓存秒数，默认 3600（1 小时）。
# 用于避免每次加载主题都走 Pages→Worker→GitHub 两次反代。设大更省回源、设小更实时。
ASSET_CACHE_TTL=3600

# 可选：默认 on。向面板 HTML 注入一段小脚本，在复制 Agent 上报命令时
# 把 `-url=https://<pages>/update` 改写为 `https://<workers>/update`，让 Agent
# 直连 Workers 上报、大幅省 Pages 额度。设为 off 可关闭该改写。
REWRITE_REPORT_URL=on
